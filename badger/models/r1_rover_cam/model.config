<?xml version="1.0"?>
<model>
  <name>r1_rover_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>DREAMS Lab / Earth Innovation Hub</name>
  </author>
  <description>
    Aion R1 (upstream PX4 gz model r1_rover) plus a forward camera for the
    Locutus twin (callsign badger). Meshes are not vendored here: install.sh
    copies them from the stock r1_rover model in the PX4 tree.
  </description>
</model>
<?xml version="1.0"?>
<model>
  <name>earth_rover</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>DREAMS Lab / Earth Innovation Hub</name>
  </author>
  <description>
    Locutus stand-in for the Earth Rover (Earth-Innovation-Hub/earth-rover):
    a 26 inch Schwinn-style trike, 65 kg, mast at 1.2 m. The front wheel
    drives and steers (PX4 Ackermann, airframe 4024). The rear wheels roll freely.
    A 1 m pad behind the mast carries AprilTag 36h11 id 1 for kestrel to land on.
    Callsign stays badger.
  </description>
</model>

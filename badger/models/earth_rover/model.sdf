<?xml version="1.0"?>
<!-- Earth Rover in the Locutus world.
     Dimensions from Earth-Innovation-Hub/earth-rover: 26 inch wheels (radius
     0.330 m), 65 kg, sensor mast 1.2 m above the ground. Airframe 4024 runs
     PX4's Ackermann bicycle controller. The front wheel is the only driven
     wheel and the only steered wheel. The rear wheels roll freely. -->
<sdf version="1.9">
  <model name="earth_rover">
    <self_collide>0</self_collide>
    <static>0</static>

    <link name="base_link">
      <inertial>
        <pose>0.10 0 0.45 0 0 0</pose>
        <mass>65.0</mass>
        <inertia>
          <ixx>5.74</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>15.2</iyy><iyz>0</iyz>
          <izz>18.3</izz>
        </inertia>
      </inertial>
      <collision name="spine">
        <pose>0.15 0 0.58 0 0 0</pose>
        <geometry><box><size>1.55 0.14 0.10</size></box></geometry>
      </collision>
      <visual name="spine">
        <pose>0.15 0 0.58 0 0 0</pose>
        <geometry><box><size>1.55 0.14 0.10</size></box></geometry>
        <material><ambient>0.15 0.17 0.16 1</ambient><diffuse>0.22 0.24 0.22 1</diffuse></material>
      </visual>
      <visual name="rear_deck">
        <pose>-0.42 0 0.66 0 0 0</pose>
        <geometry><box><size>0.62 0.78 0.06</size></box></geometry>
        <material><ambient>0.12 0.14 0.13 1</ambient><diffuse>0.18 0.20 0.18 1</diffuse></material>
      </visual>
      <visual name="solar">
        <pose>-0.48 0 0.82 0 -0.45 0</pose>
        <geometry><box><size>0.70 0.48 0.015</size></box></geometry>
        <material><ambient>0.05 0.10 0.22 1</ambient><diffuse>0.08 0.16 0.40 1</diffuse></material>
      </visual>
      <visual name="mast">
        <pose>-0.18 0 0.98 0 0 0</pose>
        <geometry><cylinder><radius>0.016</radius><length>0.72</length></cylinder></geometry>
        <material><ambient>0.55 0.55 0.52 1</ambient><diffuse>0.75 0.75 0.70 1</diffuse></material>
      </visual>
      <visual name="sensor_bar">
        <pose>-0.12 0 1.22 0 0 0</pose>
        <geometry><box><size>0.10 0.26 0.07</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="camera_left">
        <pose>-0.06 0.07 1.22 0 0.25 0</pose>
        <geometry><box><size>0.06 0.04 0.04</size></box></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <visual name="camera_right">
        <pose>-0.06 -0.07 1.22 0 0.25 0</pose>
        <geometry><box><size>0.08 0.05 0.05</size></box></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
      <!-- Landing pad behind the mast. AprilTag 36h11 id 1. The png is the
           black square itself (no quiet zone), 0.8 m on a side, matching
           apriltag_ros size. The pillar in this world is id 0. Pad top is
           0.92 m above the ground. -->
      <collision name="landing_pad">
        <pose>-1.05 0 0.90 0 0 0</pose>
        <geometry><box><size>1.05 1.05 0.04</size></box></geometry>
        <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
      </collision>
      <visual name="landing_pad">
        <pose>-1.05 0 0.90 0 0 0</pose>
        <geometry><box><size>1.05 1.05 0.04</size></box></geometry>
        <material><ambient>0.20 0.20 0.20 1</ambient><diffuse>0.30 0.30 0.30 1</diffuse></material>
      </visual>
      <visual name="apriltag_1">
        <pose>-1.05 0 0.922 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>0.8 0.8 0.001</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr><metal>
            <albedo_map>materials/textures/apriltag36h11_1.png</albedo_map>
            <roughness>0.0</roughness>
            <metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>

    <!-- Rear dual wheels. +Y is left and takes actuator 1, matching r1_rover_cam. -->
    <link name="lf_wheel_link">
      <pose>-0.40 0.40 0.330 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.04</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08</iyy><iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="lf_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="lf_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_left_inner" type="revolute">
      <parent>base_link</parent>
      <child>lf_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="lb_wheel_link">
      <pose>-0.40 0.47 0.330 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.04</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08</iyy><iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="lb_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="lb_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_left_outer" type="revolute">
      <parent>base_link</parent>
      <child>lb_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="rf_wheel_link">
      <pose>-0.40 -0.40 0.330 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.04</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08</iyy><iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="rf_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="rf_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_right_inner" type="revolute">
      <parent>base_link</parent>
      <child>rf_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="rb_wheel_link">
      <pose>-0.40 -0.47 0.330 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.04</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08</iyy><iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="rb_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.06</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="rb_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="rear_right_outer" type="revolute">
      <parent>base_link</parent>
      <child>rb_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.02</damping></dynamics>
      </axis>
    </joint>

    <link name="caster_link">
      <pose>0.90 0 0.55 0 0 0</pose>
      <inertial>
        <mass>0.4</mass>
        <inertia>
          <ixx>0.002</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.002</iyy><iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="fork">
        <pose>0 0 -0.08 0 0 0</pose>
        <geometry><box><size>0.04 0.08 0.16</size></box></geometry>
        <material><ambient>0.45 0.45 0.42 1</ambient><diffuse>0.6 0.6 0.55 1</diffuse></material>
      </visual>
    </link>
    <joint name="servo_0" type="revolute">
      <parent>base_link</parent>
      <child>caster_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.5236</lower>
          <upper>0.5236</upper>
          <velocity>1.5</velocity>
          <effort>40</effort>
        </limit>
      </axis>
    </joint>

    <link name="front_wheel_link">
      <pose>0.90 0 0.330 0 0 0</pose>
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.04</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.08</iyy><iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="front_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>1.4</mu><mu2>1.2</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="front_wheel">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.330</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <joint name="front_roll" type="revolute">
      <parent>caster_link</parent>
      <child>front_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <velocity>20</velocity>
          <effort>80</effort>
        </limit>
      </axis>
    </joint>

    <link name="front_camera_link">
      <pose>0.05 0 1.20 0 0.20 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-5</iyy><iyz>0</iyz>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.274</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>300</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>
    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>front_roll</joint_name>
      <sub_topic>command/motor_speed</sub_topic>
      <use_actuator_msg>true</use_actuator_msg>
      <actuator_number>0</actuator_number>
      <p_gain>12.0</p_gain>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>servo_0</joint_name>
      <sub_topic>servo_0</sub_topic>
      <p_gain>30</p_gain>
      <i_gain>0</i_gain>
      <d_gain>2</d_gain>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_roll</joint_name>
      <joint_name>servo_0</joint_name>
      <joint_name>rear_left_inner</joint_name>
      <joint_name>rear_left_outer</joint_name>
      <joint_name>rear_right_inner</joint_name>
      <joint_name>rear_right_outer</joint_name>
    </plugin>
  </model>
</sdf>

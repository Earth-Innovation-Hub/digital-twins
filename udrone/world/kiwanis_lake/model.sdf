<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="kiwanis_lake">
    <static>true</static>
    <!-- Kiwanis Lake Tempe. Bed and park are pictures only. No water mesh,
         no props, and no collision: the hoop, the bed tag, the bed tiles
         and the bank walls are not solid. ~12.67 acres. -->
    <link name="link">
      <visual name="bed">
        <geometry><mesh><uri>model://kiwanis_lake/meshes/bed.obj</uri></mesh></geometry>
        <!-- Planar ENU UVs, 8 m/tile; reef albedo. Neutral tint so the
             coral colours are not pulled back to brown sand. -->
        <material>
          <ambient>0.55 0.62 0.58 1</ambient>
          <diffuse>0.95 1.0 0.96 1</diffuse>
          <specular>0.06 0.08 0.07 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://kiwanis_lake/materials/textures/bed_sand.png</albedo_map>
              <roughness>0.92</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="park_fill">
        <geometry><mesh><uri>model://kiwanis_lake/meshes/park.obj</uri></mesh></geometry>
        <material>
          <ambient>0.25 0.38 0.18 1</ambient>
          <diffuse>0.25 0.38 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="park_n_vis">
        <pose>0.000 203.932 0.0 0 0 0</pose>
        <geometry><box><size>440.00 32.14 0.02</size></box></geometry>
        <material>
          <ambient>0.25 0.38 0.18 1</ambient>
          <diffuse>0.25 0.38 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="park_s_vis">
        <pose>0.000 -219.376 0.0 0 0 0</pose>
        <geometry><box><size>440.00 1.25 0.02</size></box></geometry>
        <material>
          <ambient>0.25 0.38 0.18 1</ambient>
          <diffuse>0.25 0.38 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="park_e_vis">
        <pose>214.820 -15.444 0.0 0 0 0</pose>
        <geometry><box><size>10.36 406.62 0.02</size></box></geometry>
        <material>
          <ambient>0.25 0.38 0.18 1</ambient>
          <diffuse>0.25 0.38 0.18 1</diffuse>
        </material>
      </visual>

      <!-- AprilTag 36h11 id 0, one 0.40 m plate, flat on the bed at ENU (5, 4),
           facing up. The bed surface there is z=-9.454, so the plate sits
           just above it. Local +Z of tag_plane.obj is the printed face.
           Self-lit the same way as the boat tags: the emissive map is the
           tag image, so black cells stay black. A flat emissive lifts every
           pixel the same amount and the pattern washes out. -->
      <visual name="tag_plate">
        <pose>5.0 4.0 -9.444 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><box><size>0.48 0.48 0.015</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <emissive>0.9 0.9 0.9 1</emissive>
        </material>
      </visual>
      <visual name="apriltag_0">
        <pose>5.0 4.0 -9.435 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://kiwanis_lake/meshes/tag_plane.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>1 1 1 1</emissive>
          <pbr>
            <metal>
              <albedo_map>model://kiwanis_lake/materials/textures/apriltag36h11_0.png</albedo_map>
              <emissive_map>model://kiwanis_lake/materials/textures/apriltag36h11_0.png</emissive_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Vertical hula hoop, 1 m opening, centre ENU (6, 0, -4.626).
           Visual only: the tube is not a collision. -->
      <visual name="hoop_seg_0"><pose>6 0.000 -4.126 -1.5708 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_1"><pose>6 0.250 -4.193 -2.0944 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_2"><pose>6 0.433 -4.376 -2.6180 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_3"><pose>6 0.500 -4.626 -3.1416 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_4"><pose>6 0.433 -4.876 -3.6652 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_5"><pose>6 0.250 -5.059 -4.1888 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_6"><pose>6 0.000 -5.126 -4.7124 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_7"><pose>6 -0.250 -5.059 -5.2360 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_8"><pose>6 -0.433 -4.876 -5.7596 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_9"><pose>6 -0.500 -4.626 -6.2832 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_10"><pose>6 -0.433 -4.376 -6.8068 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_11"><pose>6 -0.250 -4.193 -7.3304 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
    </link>
  </model>
</sdf>

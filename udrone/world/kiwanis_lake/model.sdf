<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="kiwanis_lake">
    <static>true</static>
    <!-- Kiwanis Lake Tempe. Bed and park are pictures only. No water mesh,
         no props, and no collision: the hoop, the tag cube, the bed tiles
         and the bank walls are not solid. ~12.67 acres. -->
    <link name="link">
      <visual name="bed">
        <geometry><mesh><uri>model://kiwanis_lake/meshes/bed.obj</uri></mesh></geometry>
        <!-- Planar ENU UVs, 8 m/tile; reef albedo. Neutral tint so the
             coral colours are not pulled back to brown sand. -->
        <material>
          <ambient>0.55 0.62 0.58 1</ambient>
          <diffuse>0.95 1.0 0.96 1</diffuse>
          <specular>0.06 0.08 0.07 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://kiwanis_lake/materials/textures/bed_sand.png</albedo_map>
              <roughness>0.92</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="park_fill">
        <geometry><mesh><uri>model://kiwanis_lake/meshes/park.obj</uri></mesh></geometry>
        <material>
          <ambient>0.25 0.38 0.18 1</ambient>
          <diffuse>0.25 0.38 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="park_n_vis">
        <pose>0.000 203.932 0.0 0 0 0</pose>
        <geometry><box><size>440.00 32.14 0.02</size></box></geometry>
        <material>
          <ambient>0.25 0.38 0.18 1</ambient>
          <diffuse>0.25 0.38 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="park_s_vis">
        <pose>0.000 -219.376 0.0 0 0 0</pose>
        <geometry><box><size>440.00 1.25 0.02</size></box></geometry>
        <material>
          <ambient>0.25 0.38 0.18 1</ambient>
          <diffuse>0.25 0.38 0.18 1</diffuse>
        </material>
      </visual>
      <visual name="park_e_vis">
        <pose>214.820 -15.444 0.0 0 0 0</pose>
        <geometry><box><size>10.36 406.62 0.02</size></box></geometry>
        <material>
          <ambient>0.25 0.38 0.18 1</ambient>
          <diffuse>0.25 0.38 0.18 1</diffuse>
        </material>
      </visual>

      <!-- AprilTag cube 0.50 m at ENU (5, 4): 36h11 id 0 on all six faces
           (0.40 m UV planes) so front / nadir / any yaw can see a tag.
           Sits on the bed. The water here is 9.49 m deep. -->
      <visual name="tag_cube">
        <pose>5.0 4.0 -9.223 0 0 0</pose>
        <geometry><box><size>0.50 0.50 0.50</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>0.98 0.98 0.98 1</diffuse>
          <emissive>0.12 0.12 0.12 1</emissive>
        </material>
      </visual>
      <!-- Face normals = local +Z of tag_plane.obj; offset 1 mm proud of cube. -->
      <visual name="apriltag_0_pz">
        <pose>5.0 4.0 -8.972 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://kiwanis_lake/meshes/tag_plane.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.25 0.25 0.25 1</emissive>
          <pbr>
            <metal>
              <albedo_map>materials/textures/apriltag36h11_0.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="apriltag_0_nz">
        <pose>5.0 4.0 -9.474 0 3.14159265359 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://kiwanis_lake/meshes/tag_plane.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.25 0.25 0.25 1</emissive>
          <pbr>
            <metal>
              <albedo_map>materials/textures/apriltag36h11_0.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="apriltag_0_px">
        <pose>5.251 4.0 -9.223 0 -1.57079632679 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://kiwanis_lake/meshes/tag_plane.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.25 0.25 0.25 1</emissive>
          <pbr>
            <metal>
              <albedo_map>materials/textures/apriltag36h11_0.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="apriltag_0_nx">
        <pose>4.749 4.0 -9.223 0 1.57079632679 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://kiwanis_lake/meshes/tag_plane.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.25 0.25 0.25 1</emissive>
          <pbr>
            <metal>
              <albedo_map>materials/textures/apriltag36h11_0.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="apriltag_0_py">
        <pose>5.0 4.251 -9.223 -1.57079632679 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://kiwanis_lake/meshes/tag_plane.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.25 0.25 0.25 1</emissive>
          <pbr>
            <metal>
              <albedo_map>materials/textures/apriltag36h11_0.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="apriltag_0_ny">
        <pose>5.0 3.749 -9.223 1.57079632679 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://kiwanis_lake/meshes/tag_plane.obj</uri></mesh></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <emissive>0.25 0.25 0.25 1</emissive>
          <pbr>
            <metal>
              <albedo_map>materials/textures/apriltag36h11_0.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Vertical hula hoop, 1 m opening, centre ENU (6, 0, -4.626).
           Visual only: the tube is not a collision. -->
      <visual name="hoop_seg_0"><pose>6 0.000 -4.126 -1.5708 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_1"><pose>6 0.250 -4.193 -2.0944 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_2"><pose>6 0.433 -4.376 -2.6180 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_3"><pose>6 0.500 -4.626 -3.1416 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>
      <visual name="hoop_seg_4"><pose>6 0.433 -4.876 -3.6652 0 0</pose><cast_shadows>false</cast_shadows><geometry><cylinder><radius>0.045</radius><length>0.28</length></cylinder></geometry><material><ambient>0.95 0.40 0.05 1</ambient><diffuse>0.95 0.45 0.08 1</diffuse><emissive>0.20 0.06 0 1</emissive></material></visual>

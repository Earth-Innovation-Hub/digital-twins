<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='xudrone'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- ============================================================ -->
    <!--  Blue Robotics 8" Series Watertight Enclosure (WTE8-ASM)     -->
    <!--  Tube: cast acrylic 11.75" / 298 mm (WTE8-P-TUBE-12)         -->
    <!--    ID 203.2 mm, OD ~222 mm (R_outer = 0.111 m)               -->
    <!--  4 × T200 Thruster R2 (BR-100545): 100 mm Ø × 113 mm,        -->
    <!--    427 g air, ~36.4 N fwd / 28.6 N rev @ 12 V                -->
    <!--  Layout: Hippocampus / udrone_boat URDF — coplanar rear      -->
    <!--    quad, thrust along +X ("quadrotor flying like a rocket")  -->
    <!-- ============================================================ -->
    <link name="base_link">
      <inertial>
        <!--
          System mass 13.5 kg on the hull (T200 mass folded in; rotor_* links are
          near-massless spin fixtures like otter jets). CG slightly below geometric
          centre so ballast keeps it upright when awash.
        -->
        <pose>0 0 -0.02 0 0 0</pose>
        <mass>13.5</mass>
        <inertia>
          <!-- Cylinder approx R=0.111 L=0.35 m=13.5 -->
          <ixx>0.083</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.179</iyy>
          <iyz>0</iyz>
          <izz>0.179</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>

      <!--
        Displacement matches 8″ OD (0.222 m) so surface equilibrium is awash:
        z_eq ≈ −R = −0.111 with the hull top at the waterline.
        4×0.0695×0.222×0.222 = 0.01370 m³ → 13.70 kgf at ρ=1000 (~1.5% reserve
        so it holds awash; boxes match 8″ OD → centre settles near z≈−0.11…−0.13).
        CG at z=-0.02 (ballast-low) keeps it upright when immersed.
      -->
      <collision name="disp_0"><pose>-0.120 0 0 0 0 0</pose><geometry><box><size>0.0695 0.222 0.222</size></box></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
      <collision name="disp_1"><pose>-0.040 0 0 0 0 0</pose><geometry><box><size>0.0695 0.222 0.222</size></box></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
      <collision name="disp_2"><pose>0.040 0 0 0 0 0</pose><geometry><box><size>0.0695 0.222 0.222</size></box></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>
      <collision name="disp_3"><pose>0.120 0 0 0 0 0</pose><geometry><box><size>0.0695 0.222 0.222</size></box></geometry><surface><friction><ode><mu>0.02</mu><mu2>0.02</mu2></ode></friction></surface></collision>

      <velocity_decay/>

      <!-- Clear acrylic tube (optical) -->
      <visual name="hull_tube">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry>
          <cylinder>
            <radius>0.111</radius>
            <length>0.298</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.55 0.75 0.90 0.35</ambient>
          <diffuse>0.55 0.75 0.90 0.35</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>
      </visual>

      <!-- O-ring flanges (8" series aluminum) -->
      <visual name="flange_aft">
        <pose>-0.160 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.118</radius><length>0.022</length></cylinder></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
      </visual>
      <visual name="flange_fwd">
        <pose>0.160 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.118</radius><length>0.022</length></cylinder></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.55 0.55 0.58 1</diffuse></material>
      </visual>

      <!-- Flat end caps -->
      <visual name="endcap_aft">
        <pose>-0.175 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.111</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>
      <visual name="endcap_fwd">
        <pose>0.175 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.111</radius><length>0.008</length></cylinder></geometry>
        <material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>

      <!-- Forward heading marker -->
      <visual name="forward_marker">
        <pose>0.12 0 0.115 0 0 0</pose>
        <geometry><box><size>0.06 0.01 0.015</size></box></geometry>
        <material><ambient>1.0 0.4 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse></material>
      </visual>

      <!-- Rigid stern cage: perfect square in YZ at X=-0.185 (Hippocampus coplanar) -->
      <visual name="mount_top">
        <pose>-0.185 0 0.14 0 0 0</pose>
        <geometry><box><size>0.012 0.28 0.012</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <visual name="mount_bottom">
        <pose>-0.185 0 -0.14 0 0 0</pose>
        <geometry><box><size>0.012 0.28 0.012</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <visual name="mount_port">
        <pose>-0.185 0.14 0 0 0 0</pose>
        <geometry><box><size>0.012 0.012 0.28</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>
      <visual name="mount_starboard">
        <pose>-0.185 -0.14 0 0 0 0</pose>
        <geometry><box><size>0.012 0.012 0.28</size></box></geometry>
        <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
      </visual>

      <!--
        T200 housings FIXED on base_link — axis-aligned boxes along +X (no RPY).
        Earlier cylinders used link pitch π/2 + joint axis 1 0 0 in the *child* frame,
        which spun thrusters about body Z and made them look skewed.
      -->
      <visual name="t200_0_housing">
        <pose>-0.20 0.14 0.14 0 0 0</pose>
        <geometry><box><size>0.113 0.10 0.10</size></box></geometry>
        <material><ambient>0.75 0.15 0.15 1</ambient><diffuse>0.75 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="t200_1_housing">
        <pose>-0.20 -0.14 0.14 0 0 0</pose>
        <geometry><box><size>0.113 0.10 0.10</size></box></geometry>
        <material><ambient>0.15 0.7 0.15 1</ambient><diffuse>0.15 0.7 0.15 1</diffuse></material>
      </visual>
      <visual name="t200_2_housing">
        <pose>-0.20 -0.14 -0.14 0 0 0</pose>
        <geometry><box><size>0.113 0.10 0.10</size></box></geometry>
        <material><ambient>0.15 0.2 0.75 1</ambient><diffuse>0.15 0.2 0.75 1</diffuse></material>
      </visual>
      <visual name="t200_3_housing">
        <pose>-0.20 0.14 -0.14 0 0 0</pose>
        <geometry><box><size>0.113 0.10 0.10</size></box></geometry>
        <material><ambient>0.75 0.7 0.12 1</ambient><diffuse>0.75 0.7 0.12 1</diffuse></material>
      </visual>

      <!-- Sensors -->
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00018665</stddev>
                <dynamic_bias_stddev>3.8785e-05</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>1000</dynamic_bias_correlation_time></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.00186</stddev>
                <dynamic_bias_stddev>0.006</dynamic_bias_stddev>
                <dynamic_bias_correlation_time>300</dynamic_bias_correlation_time></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure>
            <noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise>
          </pressure>
        </air_pressure>
      </sensor>

      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- Forward camera at hull front centre (looks along +X) -->
    <link name="front_camera_link">
      <pose>0.185 0 0 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-05</iyy><iyz>0</iyz>
          <izz>1e-05</izz>
        </inertia>
      </inertial>
      <visual name="front_camera_visual">
        <geometry><box><size>0.03 0.04 0.03</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.12 1</ambient>
          <diffuse>0.1 0.1 0.12 1</diffuse>
        </material>
      </visual>
      <sensor name="front_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <horizontal_fov>1.396</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>80</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="front_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_camera_link</child>
    </joint>

    <!-- ============================================================ -->
    <!--  Prop links: otter-style — NO link RPY, joint axis = body +X. -->
    <!--  Disk visual pitched in the *visual* only (does not affect joint). -->
    <!--  #0 port-top, #1 stbd-top, #2 stbd-bot, #3 port-bot                -->
    <!-- ============================================================ -->

    <link name="rotor_0">
      <pose>-0.145 0.14 0.14 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-06</iyy><iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="rotor_0_prop">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.038</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <link name="rotor_1">
      <pose>-0.145 -0.14 0.14 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-06</iyy><iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_prop">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.038</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <link name="rotor_2">
      <pose>-0.145 -0.14 -0.14 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-06</iyy><iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_prop">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.038</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <link name="rotor_3">
      <pose>-0.145 0.14 -0.14 0 0 0</pose>
      <gravity>true</gravity>
      <self_collide>false</self_collide>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-06</iyy><iyz>0</iyz>
          <izz>1e-06</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_prop">
        <pose>0 0 0 0 1.5707963 0</pose>
        <geometry><cylinder><radius>0.038</radius><length>0.006</length></cylinder></geometry>
        <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material>
      </visual>
    </link>
    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit><lower>-1e+16</lower><upper>1e+16</upper></limit>
        <dynamics><spring_reference>0</spring_reference><spring_stiffness>0</spring_stiffness></dynamics>
      </axis>
    </joint>

    <!-- Thruster plugins: omit <namespace> so topics follow the spawned model
         name (xudrone_0 solo, xudrone_1 when docked under otter_k). -->
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>rotor_0_joint</joint_name>
      <fluid_density>1000</fluid_density><propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>0.1</thrust_coefficient>
      <min_thrust_cmd>-40</min_thrust_cmd><max_thrust_cmd>40</max_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>rotor_1_joint</joint_name>
      <fluid_density>1000</fluid_density><propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>0.1</thrust_coefficient>
      <min_thrust_cmd>-40</min_thrust_cmd><max_thrust_cmd>40</max_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>rotor_2_joint</joint_name>
      <fluid_density>1000</fluid_density><propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>0.1</thrust_coefficient>
      <min_thrust_cmd>-40</min_thrust_cmd><max_thrust_cmd>40</max_thrust_cmd>
    </plugin>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>rotor_3_joint</joint_name>
      <fluid_density>1000</fluid_density><propeller_diameter>0.076</propeller_diameter>
      <thrust_coefficient>0.1</thrust_coefficient>
      <min_thrust_cmd>-40</min_thrust_cmd><max_thrust_cmd>40</max_thrust_cmd>
    </plugin>

    <plugin filename="gz-sim-hydrodynamics-system"
            name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xU>-1.2</xU><yV>-4.0</yV><zW>-4.0</zW>
      <kP>-0.08</kP><mQ>-1.5</mQ><nR>-1.5</nR>
      <xUabsU>-3.0</xUabsU><yVabsV>-35.0</yVabsV><zWabsW>-35.0</zWabsW>
      <kPabsP>-0.04</kPabsP><mQabsQ>-4.0</mQabsQ><nRabsR>-4.0</nRabsR>
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
    </plugin>

  </model>
</sdf>

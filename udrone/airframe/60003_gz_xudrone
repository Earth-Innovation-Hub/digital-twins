#!/bin/sh
#
# @name AUV UDrone (Gazebo)
#
# @type Underwater Robot
# @class Underwater Robot
#
# @output Motor1 T200 R2, port-top
# @output Motor2 T200 R2, starboard-top
# @output Motor3 T200 R2, starboard-bottom
# @output Motor4 T200 R2, port-bottom
#

# Source UUV defaults (MAV_TYPE 12 submarine, EKF2 EV fusion, etc.)
. ${R}/etc/init.d/rc.uuv_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=underwater}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=xudrone}

param set-default SIM_GZ_EN 1

# SITL simulated sensor enables
param set-default SENS_EN_GPSSIM 1
param set-default SENS_EN_BAROSIM 1
param set-default SENS_EN_MAGSIM 1

# Cube 2.1-style: disable ESC checks (thrusters, not ESCs)
param set-default COM_ARM_CHK_ESCS 0
param set-default FD_ESCS_EN 0

# Control allocation: UUV airframe
param set-default CA_AIRFRAME 7
param set-default CA_METHOD 0
param set-default MAV_TYPE 12

# 12V 30Ah LiFePO4 battery (4S, 3.2 V/cell nominal)
param set-default BAT1_N_CELLS 4
param set-default BAT1_CAPACITY 30000
param set-default BAT1_V_CHARGED 3.6
param set-default BAT1_V_EMPTY 2.5

# Failsafes appropriate for underwater
param set-default COM_ACT_FAIL_ACT 0
param set-default COM_LOW_BAT_ACT 0
param set-default NAV_DLL_ACT 0
param set-default GF_ACTION 1
param set-default NAV_RCL_ACT 1

# Disable attitude failure detection
param set-default FD_FAIL_P 0
param set-default FD_FAIL_R 0

# ------------------------------------------------------------------
# 4× Blue Robotics T200 R2 (BR-100545) — Hippocampus / udrone_boat
# coplanar stern square on Blue Robotics 8" WTE (WTE8-ASM-R1).
# Hull tube: ID 203.2 mm, L 298 mm, R_outer ~0.111 m.
# All primary thrust +X; positions match model.sdf rotor_* links.
# ------------------------------------------------------------------
param set-default CA_ROTOR_COUNT 4
param set-default CA_R_REV 255

# T200 #0: port-top
param set-default CA_ROTOR0_AX 1
param set-default CA_ROTOR0_AY 0
param set-default CA_ROTOR0_AZ 0
param set-default CA_ROTOR0_KM 0
param set-default CA_ROTOR0_PX -0.20
param set-default CA_ROTOR0_PY 0.14
param set-default CA_ROTOR0_PZ 0.14

# T200 #1: starboard-top
param set-default CA_ROTOR1_AX 1
param set-default CA_ROTOR1_AY 0
param set-default CA_ROTOR1_AZ 0
param set-default CA_ROTOR1_KM 0
param set-default CA_ROTOR1_PX -0.20
param set-default CA_ROTOR1_PY -0.14
param set-default CA_ROTOR1_PZ 0.14

# T200 #2: starboard-bottom
param set-default CA_ROTOR2_AX 1
param set-default CA_ROTOR2_AY 0
param set-default CA_ROTOR2_AZ 0
param set-default CA_ROTOR2_KM 0
param set-default CA_ROTOR2_PX -0.20
param set-default CA_ROTOR2_PY -0.14
param set-default CA_ROTOR2_PZ -0.14

# T200 #3: port-bottom
param set-default CA_ROTOR3_AX 1
param set-default CA_ROTOR3_AY 0
param set-default CA_ROTOR3_AZ 0
param set-default CA_ROTOR3_KM 0
param set-default CA_ROTOR3_PX -0.20
param set-default CA_ROTOR3_PY 0.14
param set-default CA_ROTOR3_PZ -0.14

# Gazebo simulated ESC outputs
param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 1100
param set-default SIM_GZ_EC_MIN2 1100
param set-default SIM_GZ_EC_MIN3 1100
param set-default SIM_GZ_EC_MIN4 1100

param set-default SIM_GZ_EC_MAX1 1900
param set-default SIM_GZ_EC_MAX2 1900
param set-default SIM_GZ_EC_MAX3 1900
param set-default SIM_GZ_EC_MAX4 1900

# --- aquatic twin: control allocation / offboard rates ---
# CT=1 so equal surge cmds stay above CA's 2% stop-motor threshold (default 6.5 -> NaN motors).
param set-default CA_ROTOR0_CT 1.0
param set-default CA_ROTOR1_CT 1.0
param set-default CA_ROTOR2_CT 1.0
param set-default CA_ROTOR3_CT 1.0
param set-default CA_METHOD 2
param set-default CA_R_REV 255
# Slight AY for roll authority (pure +X gives τx=0); same-sign as PY.
param set-default CA_ROTOR0_AY 0.05
param set-default CA_ROTOR1_AY -0.05
param set-default CA_ROTOR2_AY -0.05
param set-default CA_ROTOR3_AY 0.05
param set-default CA_ROTOR0_AX 0.9987
param set-default CA_ROTOR1_AX 0.9987
param set-default CA_ROTOR2_AX 0.9987
param set-default CA_ROTOR3_AX 0.9987
# Rates setpoints feed through as torque/thrust (body-rate / attitude offboard).
param set-default UUV_SKIP_CTRL 1

# No clock sync with the uXRCE agent (same as the Heron airframe 4023). The sim
# clock runs slower than the wall clock when the host is loaded, and the sync
# then resets every few seconds ("time jump detected"). Offboard publishers
# send timestamp 0 and PX4 stamps the message on arrival.
param set-default UXRCE_DDS_SYNCT 0

# Do not write .ulg from boot (default SDLOG_MODE 1 fills the rootfs). Match
# the other twins: log only when an operator starts a flight log.
param set-default SDLOG_MODE 0
